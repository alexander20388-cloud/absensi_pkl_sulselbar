# Dipakai untuk menjalankan lewat Docker di komputer sendiri: salin menjadi .env lalu isi nilainya. JANGAN di-commit.
# Di Streamlit Cloud, isi nilai yang sama lewat menu Settings > Secrets (nama kunci huruf kecil, mis. db_host).
# Nama kunci sama dengan secrets Streamlit (db_host -> DB_HOST, dst.). Bila nilai mengandung tanda $,
# apit dengan kutip tunggal: DB_PASSWORD='abc$def'

# --- Database ---
# Pilih SATU: DATABASE_URL, atau kelompok DB_* di bawah. DATABASE_URL menang bila keduanya diisi.
# DATABASE_URL=postgresql://user:password@host:6543/postgres

# Supabase pooler memakai port 6543. Postgres lokal dari Docker (profil dbsendiri) memakai host `db` dan port 5432.
DB_HOST=db
DB_PORT=5432
DB_USER=absensi
DB_PASSWORD=GANTI-DENGAN-PASSWORD-ACAK
DB_NAME=absensi
# COMPOSE_PROFILES=dbsendiri

# --- Keamanan aplikasi ---
ADMIN_PASSWORD=GANTI-DENGAN-PASSWORD-ADMIN
SALT=GANTI-DENGAN-STRING-ACAK-PANJANG
# Kunci API untuk api.py (hanya bila API dijalankan). Tanpa ini semua endpoint selain /health menolak permintaan.
API_KEY=GANTI-DENGAN-STRING-ACAK-PANJANG
# Kunci penandatangan token login aplikasi native peserta (api_peserta.py). Wajib bila aplikasi native dipakai; tanpa ini /v1/peserta/* menjawab 503.
# Buat: python -c "import secrets;print(secrets.token_urlsafe(48))"   (mengganti nilainya = semua peserta harus login ulang)
TOKEN_SECRET=GANTI-DENGAN-STRING-ACAK-PANJANG

# --- Privasi ---
# Peserta wajib menyetujui pemberitahuan privasi (GPS dan foto) sebelum absen. Isi 0 HANYA untuk pengembangan lokal.
PRIVASI_WAJIB=1
# Kontak yang ditampilkan di pemberitahuan privasi (mis. email atau unit Human Capital). Kosong = teks umum.
KONTAK_PRIVASI=

# --- Penyimpanan foto (Supabase Storage). Kosongkan bila foto disimpan di database. ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=
SUPABASE_ANON_KEY=
